# Ortam Değişkenleri - Bu dosyayı .env olarak kopyalayın
# cp .env.example .env
# göstermeliktir
# OpenAI API Key (valuation-service için zorunlu)
OPENAI_API_KEY=sk-proj-BURAYA_GERCEK_KEY_YAZIN

# JWT Secret Key - en az 32 karakter, güçlü rastgele değer kullanın
JWT_SECRET_KEY=buraya-en-az-32-karakterlik-guclu-bir-jwt-secret-yazin

# OpenAI model seçimi (opsiyonel, varsayılanlar aşağıda)
# OPENAI_MODEL_ANALIZ=gpt-4o-mini
# OPENAI_MODEL_CHAT=gpt-4o-mini
# OPENAI_MODEL_PAZARLIK=gpt-4.1-nano
